# Open-C3 Configuration
# Copy this file to config.env and fill in your values

# Open-C3 server base URL (required)
# Example: "http://192.168.10.67/" or "https://open-c3.example.com/"
OPEN_C3_URL="http://YOUR_OPEN_C3_SERVER/"

# Application name for API authentication (required)
# This is your app name in Open-C3 system
APP_NAME="your_app_name"

# Application key for API authentication (required)
# This is your app key in Open-C3 system - KEEP THIS SECRET!
APP_KEY="your_app_key"
